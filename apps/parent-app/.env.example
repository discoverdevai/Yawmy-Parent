# Copy to `.env` to run the parent app against the real backend.
#
# Base URL of the Spring backend (Render). No trailing "/api" — the REST auth
# client appends "/api/auth/…". Leave unset for fully-mock mode (auth + data).
# EXPO_PUBLIC_ is inlined by Metro and is the most reliable across platforms;
# NMS_API_BASE_URL feeds app.config.js -> extra.apiBaseUrl as a fallback.
EXPO_PUBLIC_API_BASE_URL=https://nursery-be.onrender.com
NMS_API_BASE_URL=https://nursery-be.onrender.com

# When a real API base URL is set, only the auth client talks to the backend;
# all other data (children, attendance, chat…) still comes from the in-memory
# mock until the full REST adapter lands.
NMS_USE_MOCKS=false
