{
  "name": "nursery-front-end",
  "version": "0.0.0",
  "private": true,
  "description": "NMS — Nursery Management System monorepo (parent Expo app, shared packages)",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "parent": "pnpm --filter parent-app start"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-native": "0.81.5"
    }
  }
}
